# Cache headers (lidos por Netlify/Cloudflare Pages; no Cloudflare proxy
# replique via Cache Rules — ver docs/runbook-cdn-gbp.md).

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.avif
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=2592000
/*.png
  Cache-Control: public, max-age=2592000
/*.svg
  Cache-Control: public, max-age=2592000

/sitemap*.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600

# HTML nunca deve ficar em cache: o documento carrega o bundle versionado.
# Sem isso o navegador pode servir um HTML antigo apontando para um JS que
# não existe mais -> falha de hidratação / tela branca.
/
  Cache-Control: no-cache, must-revalidate
/*
  Cache-Control: no-cache, must-revalidate
