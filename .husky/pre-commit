#!/usr/bin/env sh
# Lovable / 0WEB pre-commit hook.

# Allow bypass: SKIP_SEO_IMAGE_CHECK=1 git commit ...
if [ "$SKIP_SEO_IMAGE_CHECK" != "1" ]; then
  echo "[pre-commit] validating SEO images..."
  SEO_PRECOMMIT=1 node scripts/validate-seo-images.mjs
  status=$?
  if [ $status -ne 0 ]; then
    echo ""
    echo "✖ Pre-commit bloqueado: og:image/twitter:image ou max-image-preview:large inválidos."
    echo "  Corrija as imagens/metas ou rode com SKIP_SEO_IMAGE_CHECK=1 para pular."
    exit $status
  fi
fi

# Validate JSON-LD schemas (Organization/LocalBusiness/WebSite/Review/...).
if [ "$SKIP_SCHEMA_VALIDATION" != "1" ]; then
  echo "[pre-commit] validating Schema.org JSON-LD..."
  node scripts/validate-schemas.mjs
  status=$?
  if [ $status -ne 0 ]; then
    echo ""
    echo "✖ Pre-commit bloqueado: rich results inconsistentes."
    echo "  Corrija os blocos JSON-LD ou rode com SKIP_SCHEMA_VALIDATION=1 para pular."
    exit $status
  fi
fi

# Validate canonical tags in route files.
if [ "$SKIP_CANONICAL_CHECK" != "1" ]; then
  echo "[pre-commit] validating canonicals..."
  node scripts/validate-canonicals.mjs
  status=$?
  if [ $status -ne 0 ]; then
    echo ""
    echo "✖ Pre-commit bloqueado: canonicals inconsistentes."
    echo "  Corrija os links rel=canonical ou rode com SKIP_CANONICAL_CHECK=1 para pular."
    exit $status
  fi
fi

exit 0
